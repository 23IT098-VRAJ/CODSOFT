{
  "name": "taskflow-server",
  "version": "2.0.0",
  "description": "TaskFlow project management REST API",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "demo": "node scripts/demo.js",
    "test": "jest --runInBand"
  },
